# Copy to .env only if you want to run one region by hand.
# scripts/run_regions.py sets all of this for you.
REGION=mum
PORT=8001
DB_PATH=data/mum.db
# Basic build runs two regions. Add del=http://127.0.0.1:8003 in Phase 3 (Delhi).
PEERS=pun=http://127.0.0.1:8002
PEER_TOKEN=change-me
# format: key:actor:role[,key:actor:role]
API_KEYS=dev-officer:officer-mum-1:officer
SYNC_INTERVAL_MS=1000
PAGE_SIZE=200
HTTP_TIMEOUT_S=1.0
ENABLE_ADMIN=1
